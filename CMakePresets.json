{
  "version": 3,
  "configurePresets": [
    {
      "name": "local",
      "displayName": "Local LLVM-MinGW / Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "${sourceDir}/.tools/llvm-mingw-20260922-ucrt-x86_64/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/.tools/llvm-mingw-20260922-ucrt-x86_64/bin/clang++.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local",
      "configurePreset": "local",
      "jobs": 2
    }
  ]
}
